<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sheng.mapper.StudentMapper">
    <insert id="insert">
        insert into student (
            name, no, gender, phone, id_card, is_college,
            address, degree, graduation_date, clazz_id,create_time,update_time)
        values (
            #{name}, #{no}, #{gender}, #{phone}, #{idCard}, #{isCollege},
            #{address}, #{degree}, #{graduationDate}, #{clazzId},#{createTime},#{updateTime})
    </insert>
    <update id="update">
        update student
        <set>
            <if test="name != null and name.trim() != ''">
                name = #{name},
            </if>
            <if test="no != null and no.trim() != ''">
                no = #{no},
            </if>
            <if test="gender != null">
                gender = #{gender},
            </if>
            <if test="phone != null and phone.trim() != ''">
                phone = #{phone},
            </if>
            <if test="idCard != null and idCard.trim() != ''">
                id_card = #{idCard},
            </if>
            <if test="isCollege != null">
                is_college = #{isCollege},
            </if>
            <if test="address != null and address.trim() != ''">
                address = #{address},
            </if>
            <if test="degree != null">
                degree = #{degree},
            </if>
            <if test="graduationDate != null">
                graduation_date = #{graduationDate},
            </if>
            <if test="clazzId != null">
                clazz_id = #{clazzId},
            </if>
            update_time = #{updateTime}
        </set>
        where id = #{id}
    </update>
    <delete id="deleteByBatch" parameterType="java.util.List">
        <!--动态删除id在ids列表中的学生-->
        delete from student where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>

    <select id="page"
            parameterType="com.sheng.pojo.StudentQueryParam"
            resultType="com.sheng.pojo.Student">
        select
        s.*,
        c.name as clazz_name
        from student s
        left join clazz c on s.clazz_id = c.id

        <where>
            <if test="name != null and name.trim() != ''">
                and s.name like concat('%', #{name}, '%')
            </if>

            <if test="degree != null">
                and s.degree = #{degree}
            </if>

            <if test="clazzId != null">
                and c.id = #{clazzId}
            </if>
        </where>

        order by s.update_time desc
    </select>
    <select id="findById" resultType="com.sheng.pojo.Student">
        select * from student where id = #{id}
    </select>
</mapper>

